background = #000000
font-size = 11.5
window-padding-x = 50
window-padding-y = 10,0

# Send a raw newline byte (Ctrl+J) for Shift+Enter so Claude Code inserts a newline
# without going through the kitty keyboard protocol — needed because tmux's
# extended-keys handling is disabled (it mangles paste; see ~/.tmux.conf).
keybind = shift+enter=text:\n
